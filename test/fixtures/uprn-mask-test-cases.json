    },
    {
      "input": "7M36CJN!",
      "expected": null,
      "why": "punctuation"
    },
    {
      "input": "ZZZZZZZZZ",
      "expected": null,
      "why": "more than 12 digits when decoded"
    },
    {
      "input": "",
      "expected": null,
      "why": "empty"
    },
    {
      "input": null,
      "expected": null,
      "why": "missing"
    }

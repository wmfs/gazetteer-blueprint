  "encode": [
    {
      "input": null,
      "expected": null,
      "why": "missing UPRN"
    },
    {
      "input": "",
      "expected": null,
      "why": "empty"
    },
    {
      "input": 0,
      "expected": null,
      "why": "zero"
    },
    {
      "input": -1,
      "expected": null,
      "why": "negative"
    },
    {
      "input": "abc",
      "expected": null,
      "why": "not a number"
    },
    {
      "input": "12.5",
      "expected": null,
      "why": "not a whole number"
    },
    {
      "input": "1000000000000",
      "expected": null,
      "why": "more than 12 digits"
    },
    {
      "input": " 100070567650 ",
      "expected": "7M36CJNX",
      "why": "spaces around it"
    },
    {
      "input": 100070567650,
      "expected": "7M36CJNX",
      "why": "number, not text"
    },
    {
      "input": "999999999999",
      "expected": "19D3753V8",
      "why": "largest UPRN"
    },
    {
      "input": 1,
      "expected": "42ZWNCK6",
      "why": "smallest UPRN"
    }
  ],
  "decode": [
    {
      "input": "7m36cjnx",
      "expected": "100070567650",
      "why": "lower case"
    },
    {
      "input": "7M36 CJNX",
      "expected": "100070567650",
      "why": "read out in two halves"
    },
    {
      "input": "7M36-CJNX",
      "expected": "100070567650",
      "why": "hyphen"
    },
    {
      "input": " 7M36CJNX ",
      "expected": "100070567650",
      "why": "spaces around it"
    },
    {
      "input": "7M36D9OJ",
      "expected": "100070587119",
      "why": "letter O typed for zero"
    },
    {
      "input": "7M1Q7ZZM",
      "expected": "100031621765",
      "why": "Z (a swapped vowel)"
    },
    {
      "input": "7M36CJN",
      "expected": null,
      "why": "missing a character"
    },
    {
      "input": "7M36CJNA",
      "expected": null,

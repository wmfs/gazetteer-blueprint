  "encode": [
    {
      "input": null,
      "expected": null,
      "why": "missing UPRN"
    },
    {
      "input": "",
      "expected": null,
      "why": "empty"
    },
    {
      "input": 0,
      "expected": null,
      "why": "zero"
    },
    {
      "input": -1,
      "expected": null,
      "why": "negative"
    },
    {
      "input": "abc",
      "expected": null,
      "why": "not a number"
    },
    {
      "input": "12.5",
      "expected": null,
      "why": "not a whole number"
    },
    {
      "input": "1000000000000",
      "expected": null,
      "why": "more than 12 digits"
    },
    {
      "input": " 90012345678 ",
      "expected": "7ZNR7DM9",
      "why": "spaces around it"
    },
    {
      "input": 90012345678,
      "expected": "7ZNR7DM9",
      "why": "number, not text"
    },
    {
      "input": "999999999999",
      "expected": "19D3753V8",
      "why": "largest UPRN"
    },
    {
      "input": 1,
      "expected": "42ZWNCK6",
      "why": "smallest UPRN"
    }
  ],
  "decode": [
    {
      "input": "7znr7dm9",
      "expected": "90012345678",
      "why": "lower case"
    },
    {
      "input": "7ZNR 7DM9",
      "expected": "90012345678",
      "why": "read out in two halves"
    },
    {
      "input": "7ZNR-7DM9",
      "expected": "90012345678",
